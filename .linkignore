# Ignore the hidden git directory
\.git

# Ignore a specific file
README.md

# Ignore all files ending in .bak
\.bak$

# Ignore the linker scripts and their ignore file
^link\.sh$
^unlink\.sh$
^\.linkignore$
^docs/
# Linked as a whole directory by link.sh so Quickshell hot-reloads on save
^\.config/quickshell/helios/
^tests/
# Never link Python bytecode caches generated next to the helper scripts
__pycache__
\.claude
AGENTS.md
CLAUDE.md
^MISSION\.md$
^RESOURCES\.md$
^NOTES\.md$
^lessons/
^reference/
^assets/
^learning-records/

CONTEXT.md
